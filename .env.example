# ── LLM API ─────────────────────────────────────────────────────────
MIMO_API_KEY=your_api_key_here
MIMO_BASE_URL=https://api.mimo.ai/v1
MIMO_MODEL=MiMo-Lite

# Fallback: DeepSeek API
# DEEPSEEK_API_KEY=your_deepseek_key_here

# ── Reranker ────────────────────────────────────────────────────────
RERANKER_PROVIDER=local
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3

# DashScope Reranker (fallback)
# RERANKER_PROVIDER=dashscope
# RERANKER_API_KEY=your_reranker_key_here
# RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANKER_MODEL=gte-rerank

# ── Embedding ───────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/law_db

# ── Vector DB ───────────────────────────────────────────────────────
VECTOR_DB_PATH=law_faiss

# ── Session ─────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_random_string
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Redis (optional) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (optional) ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ── Retrieval Weights ──────────────────────────────────────────────
VECTOR_RETRIEVAL_WEIGHT=0.4
BM25_RETRIEVAL_WEIGHT=0.3
GRAPH_RETRIEVAL_WEIGHT=0.3
RELEVANCE_THRESHOLD=0.15

# ── Environment ────────────────────────────────────────────────────
# ENV=production
